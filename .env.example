# PomoHaven Environment Configuration Example
# Copy this file to .env and insert your Google Cloud OAuth 2.0 Web Application credentials

# Secret Key for Flask sessions
SECRET_KEY=pomohaven-study-secret-key-2026

# Google OAuth 2.0 Web Client Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
